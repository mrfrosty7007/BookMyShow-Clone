# Backend Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/bookmyshow_clone?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_production_signing_key_change_me
