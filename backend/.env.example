# ==========================================
# BookMyShow Clone — Backend Environment Variables
# ==========================================

# Server Listening Port (Railway / Render injects this automatically)
PORT=5000

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/bookmyshow_clone?retryWrites=true&w=majority

# JWT Secret Key for signing HTTP-only cookies
JWT_SECRET=super_secret_jwt_production_signing_key_change_me

# Client Application URL for CORS whitelist (e.g. Vercel deployment URL)
CLIENT_URL=http://localhost:5173

# Application Environment: 'development' or 'production'
NODE_ENV=development
