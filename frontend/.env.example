# ==========================================
# BookMyShow Clone — Frontend Environment Variables
# ==========================================

# API Base URL:
# - In local development: leave empty or set to /api (Vite dev server proxies /api to http://localhost:5000)
# - In production (e.g. Vercel): set to your deployed backend URL ending with /api
# Example: https://bookmyshow-api-57un.onrender.com/api
VITE_API_URL=/api

# Optional: Override local dev backend proxy target (defaults to http://localhost:5000)
VITE_DEV_BACKEND_URL=http://localhost:5000
